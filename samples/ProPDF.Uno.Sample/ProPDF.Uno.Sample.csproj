<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFramework />
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>Skia;SkiaRenderer</UnoFeatures>
    <!-- No implicit service locator, commercial tooling, X11 video or Win32 SDK metadata. -->
    <DisableImplicitUnoPackages>true</DisableImplicitUnoPackages>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <LangVersion>14.0</LangVersion>
    <ApplicationTitle>ProPDF Uno</ApplicationTitle>
    <ApplicationId>org.propdf.uno</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>ProPDF</ApplicationPublisher>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmShellILLinkerEnabled>false</WasmShellILLinkerEnabled>
    <WasmShellWebAppBasePath>/ProPDF/</WasmShellWebAppBasePath>
    <WasmShellGenerateCompressedFiles>false</WasmShellGenerateCompressedFiles>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('browserwasm'))">
    <DefineConstants>$(DefineConstants);BROWSER_WASM</DefineConstants>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ProPDF.Uno/ProPDF.Uno.csproj" />
    <ProjectReference Include="../ProPDF.SampleSupport/ProPDF.SampleSupport.csproj" />
    <PackageReference Include="Uno.WinUI" Version="6.7.135" />
    <PackageReference Include="Uno.WinUI.Graphics2DSK" Version="6.7.135" />
    <PackageReference Include="Uno.Fonts.OpenSans" Version="2.9.4" />
    <Content Include="browser-host.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../artifacts/upstream-notices/*.txt" Link="licenses/Uno/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('browserwasm'))">
    <PackageReference Include="Uno.Wasm.Bootstrap" Version="10.0.98" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.WebAssembly.Browser" Version="6.7.135" />
    <PackageReference Include="Uno.WinUI.Runtime.WebAssembly" Version="6.7.135" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('desktop'))">
    <PackageReference Include="Uno.WinUI.Runtime.Skia.MacOS" Version="6.7.135" />
  </ItemGroup>
  <Target Name="RequireUnoSampleNotices" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../artifacts/upstream-notices/ICU-77-LICENSE.txt')" Text="Run python scripts/fetch-uno-notices.py before publishing the Uno sample." />
  </Target>
</Project>
