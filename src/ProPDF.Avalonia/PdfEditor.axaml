<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPDF.Avalonia"
             x:Class="ProPDF.Avalonia.PdfEditor" x:Name="EditorRoot" x:CompileBindings="False" Background="#F4F6FA" Foreground="#17243C">
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#315CE7"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="#AD2941"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#67758D"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#67758D"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="52,Auto,Auto,*,32">
    <Border Grid.Row="0" Background="#12213D" Padding="20,0">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" Text="ProPDF" FontSize="23" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,26,0"/>
        <TextBlock DockPanel.Dock="Right" Text="DESKTOP EDITOR · ALPHA" FontSize="10" Foreground="#9EB1D3" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DisplayName}" Foreground="#D5DFF1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="White" BorderBrush="#DDE3ED" BorderThickness="0,0,0,1" Padding="8,5">
      <WrapPanel Orientation="Horizontal">
        <Button Content="New" Command="{Binding NewCommand}"/><Button Content="Open" Command="{Binding OpenCommand}"/><Button Content="Open protected" Command="{Binding OpenProtectedCommand}"/>
        <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}"/><Button Content="Save as" Command="{Binding SaveAsCommand}"/>
        <Button Content="Undo" Command="{Binding UndoCommand}"/><Button Content="Redo" Command="{Binding RedoCommand}"/>
        <Button Content="Merge PDF" Command="{Binding MergeCommand}"/><Button Content="Export page" Command="{Binding ExtractPageCommand}"/>
        <ComboBox Width="157" Margin="10,3,4,3" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Width="205" Margin="3" PlaceholderText="Text, comment or new field name" Text="{Binding ToolText, Mode=TwoWay}"/>
        <Button Content="Copy text" Command="{Binding CopyCommand}"/>
      </WrapPanel>
    </Border>
    <Border Grid.Row="2" Background="#F9FAFD" BorderBrush="#DDE3ED" BorderThickness="0,0,0,1" Padding="8,4">
      <WrapPanel Orientation="Horizontal">
        <Button Content="‹" ToolTip.Tip="Previous page" Command="{Binding PreviousPageCommand}"/><Button Content="›" ToolTip.Tip="Next page" Command="{Binding NextPageCommand}"/>
        <TextBox Width="43" Margin="3" Text="{Binding PageInput, Mode=TwoWay}"/><Button Content="Go" Command="{Binding GoToPageCommand}"/>
        <TextBlock Text="{Binding PageLabel}" Margin="5,0,12,0" VerticalAlignment="Center" FontSize="12"/>
        <Button Content="−" Command="{Binding ZoomOutCommand}"/><TextBlock Text="{Binding ZoomLabel}" Width="48" VerticalAlignment="Center" TextAlignment="Center" FontSize="12"/><Button Content="+" Command="{Binding ZoomInCommand}"/>
        <Button Content="Fit width" Command="{Binding FitWidthCommand}"/><Button Content="Fit page" Command="{Binding FitPageCommand}"/>
        <ComboBox Width="118" Margin="5,3" ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding LayoutMode, Mode=TwoWay}"/>
        <TextBox Width="180" Margin="8,3,3,3" PlaceholderText="Search document" Text="{Binding SearchQuery, Mode=TwoWay}"/>
        <Button Content="Find" Command="{Binding SearchCommand}"/><Button Content="‹" ToolTip.Tip="Previous match" Command="{Binding PreviousMatchCommand}"/><Button Content="›" ToolTip.Tip="Next match" Command="{Binding NextMatchCommand}"/>
        <TextBlock Text="{Binding MatchLabel}" Margin="8,0" VerticalAlignment="Center" FontSize="11"/>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="188,4,*,4,272">
      <DockPanel Grid.Column="0" Background="#F6F8FC">
        <StackPanel DockPanel.Dock="Top" Margin="10,6">
          <TextBlock Text="PAGES" Classes="caption" Margin="6,8,0,7"/>
          <WrapPanel><Button Content="Rotate" Command="{Binding RotateCommand}"/><Button Content="Insert" Command="{Binding InsertPageCommand}"/><Button Content="Delete" Classes="danger" Command="{Binding DeletePageCommand}"/></WrapPanel>
          <WrapPanel><Button Content="Duplicate" Command="{Binding DuplicatePageCommand}"/><Button Content="↑" Command="{Binding MoveUpCommand}"/><Button Content="↓" Command="{Binding MoveDownCommand}"/></WrapPanel>
        </StackPanel>
        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,6" Spacing="5" HorizontalAlignment="Center">
                <local:PdfThumbnail Controller="{Binding DataContext.Viewport, RelativeSource={RelativeSource AncestorType={x:Type local:PdfEditor}}}" PageNumber="{Binding Number}"/>
                <TextBlock Text="{Binding Number, StringFormat='Page {0}'}" TextAlignment="Center" FontSize="11" Foreground="#53627C"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Background="#E1E6EF" ResizeDirection="Columns"/>
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Border Background="White" BorderBrush="#E0E5ED" BorderThickness="0,0,0,1" Padding="8,4">
          <WrapPanel>
            <Button Content="Crop selection" Command="{Binding CropCommand}"/><Button Content="Image in selection" Command="{Binding InsertImageCommand}"/>
            <Button Content="Apply redactions" Classes="danger" Command="{Binding ApplyRedactionsCommand}"/><Button Content="Clear marks" Command="{Binding ClearRedactionsCommand}"/>
          </WrapPanel>
        </Border>
        <local:PdfView Grid.Row="1" Controller="{Binding Viewport}"/>
      </Grid>
      <GridSplitter Grid.Column="3" Background="#E1E6EF" ResizeDirection="Columns"/>
      <DockPanel Grid.Column="4" Background="White">
        <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="#E3E8F0" BorderThickness="0,0,0,1"><TextBlock Text="INSPECTOR" FontSize="11" FontWeight="SemiBold" Foreground="#617089"/></Border>
        <TabControl>
          <TabItem Header="Review">
            <ScrollViewer><StackPanel Margin="12,8" Spacing="7">
              <TextBlock Text="COMMENTS" Classes="caption"/>
              <ListBox ItemsSource="{Binding Annotations}" SelectedItem="{Binding SelectedAnnotation, Mode=TwoWay}" Height="220">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3"><TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Contents}" TextWrapping="Wrap" MaxHeight="55" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBox Text="{Binding Comment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" PlaceholderText="Select a comment"/>
              <WrapPanel><Button Content="Update" Command="{Binding UpdateCommentCommand}"/><Button Content="Delete" Command="{Binding DeleteAnnotationCommand}"/></WrapPanel>
              <TextBlock Classes="hint" Text="Choose a tool, then drag on the page. Text and note tools use the text box in the main toolbar."/>
              <TextBlock Text="REDACTION" Classes="caption"/>
              <TextBlock Classes="hint" Text="Mark regions, inspect them, then choose Apply redactions. Marks alone never remove PDF content."/>
              <Button Content="Refresh inspector" Command="{Binding RefreshInspectorCommand}"/>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Forms">
            <ScrollViewer><StackPanel Margin="12,8" Spacing="8">
              <TextBlock Text="FORM FIELDS" Classes="caption"/>
              <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Text="{Binding FieldValue, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" PlaceholderText="Field value"/>
              <Button Content="Apply value" Classes="primary" Command="{Binding SetFieldValueCommand}"/>
              <Button Content="Flatten all fields" Command="{Binding FlattenFormsCommand}"/>
              <TextBlock Classes="hint" Text="Use Text form field or Checkbox field in the tool selector to draw a new field. Enter a unique field name in the toolbar text box. Read-only fields cannot be changed."/>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Document">
            <ScrollViewer><StackPanel Margin="12,8" Spacing="5">
              <TextBlock Text="Title" Classes="caption"/><TextBox Text="{Binding DocumentTitle, Mode=TwoWay}"/>
              <TextBlock Text="Author" Classes="caption"/><TextBox Text="{Binding DocumentAuthor, Mode=TwoWay}"/>
              <TextBlock Text="Subject" Classes="caption"/><TextBox Text="{Binding DocumentSubject, Mode=TwoWay}"/>
              <TextBlock Text="Keywords" Classes="caption"/><TextBox Text="{Binding DocumentKeywords, Mode=TwoWay}"/>
              <Button Content="Save metadata" Command="{Binding SaveMetadataCommand}"/>
              <TextBlock Text="ATTACHMENTS" Classes="caption"/>
              <ListBox ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment, Mode=TwoWay}" Height="100">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel><Button Content="Add" Command="{Binding AddAttachmentCommand}"/><Button Content="Save" Command="{Binding SaveAttachmentCommand}"/><Button Content="Remove" Command="{Binding DeleteAttachmentCommand}"/></WrapPanel>
              <TextBlock Text="BOOKMARKS" Classes="caption"/>
              <ListBox ItemsSource="{Binding Bookmarks}" Height="90"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox>
              <Button Content="Bookmark current page" Command="{Binding AddBookmarkCommand}" ToolTip.Tip="Uses the toolbar text as the bookmark title"/>
            </StackPanel></ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
    <Border Grid.Row="4" Background="White" BorderBrush="#DDE3ED" BorderThickness="0,1,0,0" Padding="14,0">
      <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" VerticalAlignment="Center" FontSize="11" Foreground="#596B86" TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</UserControl>
