<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProPDF.Avalonia" x:Class="ProPDF.Avalonia.PdfEditor" x:Name="EditorRoot" x:CompileBindings="False" Background="#F5F5F5" Foreground="#292929" FontSize="12">
  <UserControl.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="5,6"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1465DC"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#AD2941"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#686868"/>
      <Setter Property="Margin" Value="0,12,0,5"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#686868"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#EAEAEA"/>
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#1465DC"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="PageThumbnailTemplate">
      <StackPanel Margin="4,6" Spacing="5" HorizontalAlignment="Center">
        <local:PdfThumbnail Controller="{Binding DataContext.Viewport, RelativeSource={RelativeSource AncestorType={x:Type local:PdfEditor}}}" PageNumber="{Binding Number}"/>
        <TextBlock Text="{Binding Number, StringFormat='Page {0}'}" TextAlignment="Center" FontSize="11" Foreground="#53627C"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl x:Name="InspectorTabs" BorderThickness="0" Background="White" Padding="0">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <ContentPresenter x:Name="PART_SelectedContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
      </ControlTemplate>
    </TabControl.Template>
    <TabItem Header="Edit">
      <local:PdfContentPanel/>
    </TabItem>
    <TabItem Header="Review">
      <ScrollViewer>
        <StackPanel Margin="12,8" Spacing="7">
          <TextBlock Text="COMMENTS" Classes="caption"/>
          <ListBox ItemsSource="{Binding Annotations}" SelectedItem="{Binding SelectedAnnotation, Mode=TwoWay}" Height="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Contents}" TextWrapping="Wrap" MaxHeight="55" FontSize="12"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox Text="{Binding Comment, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" PlaceholderText="Select a comment"/>
          <WrapPanel>
            <Button Content="Update" Command="{Binding UpdateCommentCommand}"/>
            <Button Content="Delete" Command="{Binding DeleteAnnotationCommand}"/>
          </WrapPanel>
          <TextBlock Classes="hint" Text="Choose a tool, then drag on the page. Text and note tools use the text box in the tool settings."/>
          <TextBlock Text="REDACTION" Classes="caption"/>
          <TextBlock Classes="hint" Text="Mark regions, inspect them, then choose Apply redactions. Marks alone never remove PDF content."/>
          <Button Content="Refresh inspector" Command="{Binding RefreshInspectorCommand}"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Forms">
      <ScrollViewer>
        <StackPanel Margin="12,8" Spacing="8">
          <TextBlock Text="FORM FIELDS" Classes="caption"/>
          <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Text="{Binding FieldValue, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" PlaceholderText="Field value"/>
          <Button Content="Apply value" Classes="primary" Command="{Binding SetFieldValueCommand}"/>
          <Button Content="Flatten all fields" Command="{Binding FlattenFormsCommand}"/>
          <TextBlock Classes="hint" Text="Use Text form field or Checkbox field in the tool selector to draw a new field. Enter a unique field name in the tool-settings text box. Read-only fields cannot be changed."/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Navigate">
      <local:PdfNavigationPanel/>
    </TabItem>
    <TabItem Header="Export">
      <ScrollViewer>
        <local:PdfOutputToolbar/>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Document">
      <ScrollViewer>
        <StackPanel Margin="12,8" Spacing="5">
          <TextBlock Text="Title" Classes="caption"/>
          <TextBox Text="{Binding DocumentTitle, Mode=TwoWay}"/>
          <TextBlock Text="Author" Classes="caption"/>
          <TextBox Text="{Binding DocumentAuthor, Mode=TwoWay}"/>
          <TextBlock Text="Subject" Classes="caption"/>
          <TextBox Text="{Binding DocumentSubject, Mode=TwoWay}"/>
          <TextBlock Text="Keywords" Classes="caption"/>
          <TextBox Text="{Binding DocumentKeywords, Mode=TwoWay}"/>
          <Button Content="Save metadata" Command="{Binding SaveMetadataCommand}"/>
          <TextBlock Text="ATTACHMENTS" Classes="caption"/>
          <ListBox ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment, Mode=TwoWay}" Height="100">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel>
            <Button Content="Add" Command="{Binding AddAttachmentCommand}"/>
            <Button Content="Save" Command="{Binding SaveAttachmentCommand}"/>
            <Button Content="Remove" Command="{Binding DeleteAttachmentCommand}"/>
          </WrapPanel>
          <TextBlock Text="BOOKMARKS" Classes="caption"/>
          <ListBox ItemsSource="{Binding Bookmarks}" Height="90">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Bookmark current page" Command="{Binding AddBookmarkCommand}" ToolTip.Tip="Uses the tool-settings text as the bookmark title"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
